<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador MSI do Pulsares Explorer (WiX Toolset v5).
  Uso: wix build pulsares-explorer.wxs -arch x64 -ext WixToolset.UI.wixext
       -d Version=1.2.0 -d BinaryPath=... -d IconPath=... -d LicenseRtf=... -o Pulsares-Explorer.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Pulsares Explorer"
           Manufacturer="Pulsares"
           Version="$(var.Version)"
           UpgradeCode="6E7A2C14-3B5F-4D8E-9A21-7C4F0B9D5E31"
           Language="1046"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Pulsares Explorer — explorador de arquivos com Studio Editor e DB Studio" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Pulsares Explorer já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Icon Id="StudioIcon" SourceFile="$(var.StudioIconPath)" />
    <Icon Id="DBStudioIcon" SourceFile="$(var.DBStudioIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vitorkrewer/pulsares-file-explorer" />
    <Property Id="ARPHELPLINK" Value="https://github.com/vitorkrewer/pulsares-file-explorer/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pulsares Explorer" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="PulsaresExe" Source="$(var.BinaryPath)" Name="pulsares-explorer.exe" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile">
        <File Id="LicenseTxt" Source="$(var.LicenseTxt)" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcuts" Directory="ProgramMenuFolder" Guid="A3D1F6B2-8C47-4E59-B0D3-2F6E8A1C9B47">
      <Shortcut Id="ExplorerStartShortcut"
                Name="Pulsares Explorer"
                Description="Explorador de arquivos rápido e multiplataforma"
                Target="[INSTALLFOLDER]pulsares-explorer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <Shortcut Id="StudioStartShortcut"
                Name="Pulsares Studio Editor"
                Description="Editor de código integrado do Pulsares"
                Target="[INSTALLFOLDER]pulsares-explorer.exe"
                Arguments="--studio"
                WorkingDirectory="INSTALLFOLDER"
                Icon="StudioIcon" />
      <Shortcut Id="DBStudioStartShortcut"
                Name="Pulsares DB Studio"
                Description="Gerenciador de bancos SQLite do Pulsares"
                Target="[INSTALLFOLDER]pulsares-explorer.exe"
                Arguments="--dbstudio"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DBStudioIcon" />
      <RegistryValue Root="HKMU" Key="Software\Pulsares\Explorer" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="5B9E2D47-1F3A-4C68-8E05-D7A4C2B613F9">
      <Shortcut Id="ExplorerDesktopShortcut"
                Name="Pulsares Explorer"
                Target="[INSTALLFOLDER]pulsares-explorer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKMU" Key="Software\Pulsares\Explorer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Pulsares Explorer" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>

